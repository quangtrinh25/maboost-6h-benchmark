      "imputation",
      "feature_selection",
      "training",
      "fusion_selection",
      "calibration",
      "threshold_selection"
    ],
    "target_labels_first_allowed_stage": "locked_evaluation_metrics"
  },
  "matched_augmentation": {
    "architectures": [
      "XGBOOST-FLAT",
      "XGBOOST-SUMMARY+STATIC",
      "Hybrid-plain",
      "MABOOST"
    ],
    "regimes": [
      "full_only",
      "stress_augmented"
    ],
    "same_splits_views_weights_and_source_validation_objective": true
