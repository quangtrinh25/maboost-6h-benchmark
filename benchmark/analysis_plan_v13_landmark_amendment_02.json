{
  "schema_version": "2.0.0",
  "analysis_id": "maboost_6h_correction09_public_reproduction",
  "created_at": "2026-09-18",
  "status": "public_reproduction_recipe",
  "prespecification_statement": "Public reproduction of the post-audit correction09 recorded-availability policy. This portable recipe has its own code/configuration identity; it does not inherit author approvals, private audit comparisons, or completed results.",
  "datasets": {
    "mimic_iv": {
      "release": "3.1",
      "role": "development_source_and_reverse_target",
      "raw_root": "data/raw/mimiciv"
    },
    "eicu": {
      "release": "2.0",
      "role": "development_source_and_forward_target",
      "raw_root": "data/raw/eicu"
    },
    "mimic_iii_carevue": {
      "release": "1.4",
      "role": "nonoverlap_historical_external_target_only",
      "raw_root": "data/raw/mimic3-carevue/1.4",
      "required_resource": "https://physionet.org/content/mimic3-carevue/1.4/"
    },
    "mimic_iii_full": {
      "role": "excluded_from_corrected_analysis",
      "reason": "The full MIMIC-III release overlaps MIMIC-IV and cannot support an independent external-validation claim."
    }
  },
  "cohort": {
    "minimum_age_years": 65,
    "landmark_hours": 6.0,
    "risk_set": "alive_and_in_icu_at_landmark",
    "predictor_window": "closed 0-6h event window and independent-time cutoff where available; retained unverified event-time sources disclosed",
    "mortality_outcome": "death_during_same_icu_stay_strictly_after_6h_landmark",
    "remaining_los_outcome_days": "icu_discharge_time_minus_(icu_admission_time_plus_6h)",
    "one_primary_evaluation_row_per_stay": true,
    "group_split_fields": {
      "mimic_iv": "subject_id",
      "eicu": "uniquepid",
      "mimic_iii_carevue": "subject_id"
    }
  },
  "feature_contract": {
    "dynamic_feature_count": 40,
    "temporal_summary_statistics_per_feature": [
      "last",
      "mean",
      "maximum",
      "minimum",
      "standard_deviation"
    ],
    "temporal_summary_count": 200,
    "observedness_rate_count": 40,
    "static_features": [
      "age",
      "gender_male",
      "emergency_admit",
      "elective_admit",
      "insurance_medicare",
      "insurance_medicaid",
      "insurance_private",
      "micu",
      "sicu",
      "cicu",
      "nicu",
      "csru"
    ],
    "static_feature_count": 12,
    "excluded_static_features": "all_30_elixhauser_flags_derived_from_untimestamped_or_full_hospitalization_diagnoses",
    "dimensions": {
      "mamba_z_only": 512,
      "xgboost_flat": 200,
      "xgboost_summary_static": 212,
      "hybrid_plain": 724,
      "flat_head": 252
    }
  },
  "mamba": {
    "event_max_tokens": 96,
    "d_model": 128,
    "d_state": 32,
    "d_conv": 4,
    "expand": 2,
    "n_layers": 4,
    "dropout": 0.1,
    "event_embeddings": [
      "value_128d",
      "variable_128d",
      "time_gap_circadian_128d"
    ],
    "token_fusion": "concatenate_384d_then_linear_and_layernorm_to_128d",
    "pooling": [
      "last",
      "mean",
      "max",
      "attention"
    ],
    "pooled_temporal_dimension": 512,
    "hyperparameter_search": false,
    "recipe_policy": "retain_v13_recipe_except_for_the_locked_landmark_and_time_safe_static_contract"
  },
  "seeds": [
    42,
    137,
    2025,
    2718,
    31415
  ],
  "model_registry": [
    "MABOOST",
    "Hybrid-plain",
    "Mamba-z-only",
    "Flat-head",
    "XGBOOST-FLAT",
    "XGBOOST-SUMMARY+STATIC",
    "GRU-D",
    "LSTM",
    "Transformer",
    "TCN",
    "SAnD",
    "STraTS",
    "InterpNet",
    "DuETT"
  ],
  "transfer_directions": [
    {
      "source": "mimic_iv",
      "targets": [
        "eicu",
        "mimic_iii_carevue"
      ]
    },
    {
      "source": "eicu",
      "targets": [
        "mimic_iv",
        "mimic_iii_carevue"
      ]
    }
  ],
  "target_label_firewall": {
    "physical_feature_label_separation": true,
