  "stress_scenarios": [
    "full_6h",
    "early_0_5h",
    "early_1h",
    "early_2h",
    "early_3h",
    "early_4h",
    "early_5h",
    "random_prefix",
    "random_window_1h",
    "random_window_2h",
    "random_window_4h",
    "event_budget_1",
    "event_budget_2",
    "event_budget_4",
    "event_budget_8",
    "event_budget_16",
    "event_budget_32",
    "event_budget_64",
    "sparse",
    "dense",
    "low_gap_variance",
    "high_gap_variance",
    "important_lab_loss",
    "lab_panel_dropout",
    "feature_dropout_30pct",
    "event_dropout_50pct",
    "delayed_update_2h",
    "late_only_5_to_6h"
  ],
  "metrics": {
    "mortality": [
      "auroc",
      "auprc",
      "brier",
      "ece",
      "calibration_intercept",
      "calibration_slope"
    ],
    "remaining_los": [
      "mae_days",
      "rmse_days"
    ],
    "primary_selection_metric": "source_validation_auprc",
    "bootstrap_replicates": 10000,
    "permutation_replicates": 10000,
    "cluster_unit": "patient",
    "seed_policy": "report_each_seed_and_mean_sd_without_treating_seeds_as_independent_samples"
  },
  "primary_contrasts": [
    "MABOOST_vs_XGBOOST-SUMMARY+STATIC",
    "MABOOST_vs_XGBOOST-FLAT",
    "stress_augmented_vs_full_only_within_architecture",
    "augmented_MABOOST_vs_augmented_XGBOOST-SUMMARY+STATIC"
  ],
  "evidence_families": [
    "mimic_iv_source_primary",
    "eicu_source_primary",
    "fixed_risk_set_temporal_stress",
    "matched_augmentation",
    "component_ablation"
  ],
  "execution_gates": {
    "execution_owner": "reproducing_user",
    "run_identity": "fresh_local_code_and_configuration_bound",
    "required_stages": [
      "init",
      "build-kernel",
      "preflight",
      "etl",
      "train",
      "analyze",
      "explain",
      "report"
    ]
  },
  "resource_guardian": {
    "ram_cleanup_fraction": 0.85,
    "ram_critical_stop_fraction": 0.95,
    "vram_process_fraction": 0.95,
    "process_isolation_per_model_seed": true,
    "resume_requires_artifact_hash_match": true
  },
